      --UC-1.4:- view patient visit history--
      
      
		 SELECT
         a.appointment_date,
         d.doctor_name,
         v.diagnosis,
         v.prescription
    	 FROM appointments a
    	 JOIN visits v
         ON a.appointment_id = v.appointment_id
    	 JOIN doctors d
         ON a.doctor_id = d.doctor_id
    	 WHERE a.patient_id = 1
    	 ORDER BY a.appointment_date;
      
      	+------------------+-----------------+----------------+-------------------------+
		| appointment_date | doctor_name     | diagnosis      | prescription            |
