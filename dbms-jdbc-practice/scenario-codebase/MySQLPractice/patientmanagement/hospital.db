     --create table visits--
     
     CREATE TABLE visits (
        visit_id INT AUTO_INCREMENT PRIMARY KEY,
        appointment_id INT,
        diagnosis VARCHAR(255),
        prescription VARCHAR(255),
        FOREIGN KEY (appointment_id) REFERENCES appointments(appointment_id)
    );
    
