	 --UC:-2.3 View Doctors by Specialty
	 
	  SELECT
	   d.doctor_name,
       d.contact,
       d.consultation_fee,
   	   s.specialty_name
       FROM doctors d
   	   JOIN specialties s
       ON d.specialty_id = s.specialty_id
       WHERE s.specialty_name = 'Cardiology'
       AND d.is_active = TRUE;
       
